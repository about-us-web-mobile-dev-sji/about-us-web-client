<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="fr-CA" target-language="en-US" datatype="html">
    <body>
      <!-- App Root -->
      <trans-unit id="main" datatype="html">
        <source>Main content</source>
        <target>Main content</target>
      </trans-unit>
      <trans-unit id="content" datatype="html">
        <source>Content</source>
        <target>Content</target>
      </trans-unit>

      <!-- Login Page -->
      <trans-unit id="login-page" datatype="html">
        <source>Login page</source>
        <target>Login page</target>
      </trans-unit>
      <trans-unit id="password-changed" datatype="html">
        <source>Mot de passe modifié. Toutes les sessions ont été fermées. Connecte-toi avec ton nouveau mot de passe.</source>
        <target>Password changed. All sessions have been closed. Log in with your new password.</target>
      </trans-unit>
      <trans-unit id="login-error" datatype="html">
        <source>{{ auth.error() }}</source>
        <target>{{ auth.error() }}</target>
      </trans-unit>

      <!-- Super Admin Dashboard -->
      <trans-unit id="super-admin-dashboard" datatype="html">
        <source>Super admin dashboard</source>
        <target>Super admin dashboard</target>
      </trans-unit>
      <trans-unit id="welcome" datatype="html">
        <source>Bienvenue, Super Admin</source>
        <target>Welcome, Super Admin</target>
      </trans-unit>

      <!-- Event Logs Page -->
      <trans-unit id="event-logs-administration" datatype="html">
        <source>Administration</source>
        <target>Administration</target>
      </trans-unit>
      <trans-unit id="event-logs-title" datatype="html">
        <source>Journaux d'événements</source>
        <target>Event Logs</target>
      </trans-unit>
      <trans-unit id="event-logs-refresh" datatype="html">
        <source>{{ eventLogsFacade.isLoading() ? 'Chargement...' : 'Actualiser' }}</source>
        <target>{{ eventLogsFacade.isLoading() ? 'Loading...' : 'Refresh' }}</target>
      </trans-unit>
      <trans-unit id="event-logs-all-types" datatype="html">
        <source>Tous les types</source>
        <target>All types</target>
      </trans-unit>
      <trans-unit id="event-logs-filter" datatype="html">
        <source>Filtrer</source>
        <target>Filter</target>
      </trans-unit>
      <trans-unit id="event-logs-list" datatype="html">
        <source>Liste des journaux d'événements</source>
        <target>List of event logs</target>
      </trans-unit>
      <trans-unit id="event-logs-loading" datatype="html">
        <source>Chargement des journaux...</source>
        <target>Loading logs...</target>
      </trans-unit>
      <trans-unit id="event-logs-empty" datatype="html">
        <source>Aucun journal disponible.</source>
        <target>No logs available.</target>
      </trans-unit>

      <!-- Event Log Detail Page -->
      <trans-unit id="event-log-detail-page" datatype="html">
        <source>Event log detail page</source>
        <target>Event log detail page</target>
      </trans-unit>
      <trans-unit id="event-log-back" datatype="html">
        <source>Retour aux journaux</source>
        <target>Back to logs</target>
      </trans-unit>
      <trans-unit id="event-log-detail-header" datatype="html">
        <source>Detail du journal</source>
        <target>Log detail</target>
      </trans-unit>
      <trans-unit id="event-log-name" datatype="html">
        <source>{{ log?.name || 'Journal d\'événement' }}</source>
        <target>{{ log?.name || 'Event Log' }}</target>
      </trans-unit>
      <trans-unit id="event-log-loading" datatype="html">
        <source>Chargement du détail...</source>
        <target>Loading details...</target>
      </trans-unit>
      <trans-unit id="event-log-id" datatype="html">
        <source>Identifiant</source>
        <target>Identifier</target>
      </trans-unit>
      <trans-unit id="event-log-entity-type" datatype="html">
        <source>Type d'entité</source>
        <target>Entity type</target>
      </trans-unit>
      <trans-unit id="event-log-entity-id" datatype="html">
        <source>Identifiant de l'entité</source>
        <target>Entity identifier</target>
      </trans-unit>
      <trans-unit id="event-log-actor" datatype="html">
        <source>Acteur</source>
        <target>Actor</target>
      </trans-unit>
      <trans-unit id="event-log-actor-empty" datatype="html">
        <source>Non renseigné</source>
        <target>Not specified</target>
      </trans-unit>
      <trans-unit id="event-log-date" datatype="html">
        <source>Date</source>
        <target>Date</target>
      </trans-unit>
      <trans-unit id="event-log-payload" datatype="html">
        <source>Payload</source>
        <target>Payload</target>
      </trans-unit>

      <!-- Create School Page -->
      <trans-unit id="create-school-page" datatype="html">
        <source>Create school page</source>
        <target>Create school page</target>
      </trans-unit>
      <trans-unit id="create-school-title" datatype="html">
        <source>Enregistrer une nouvelle école</source>
        <target>Register a new school</target>
      </trans-unit>
      <trans-unit id="create-school-description" datatype="html">
        <source>Remplis les informations ci-dessous pour créer un nouvel espace administratif sur la plateforme.</source>
        <target>Fill in the information below to create a new administrative space on the platform.</target>
      </trans-unit>
      <trans-unit id="create-school-required-fields" datatype="html">
        <source>Les champs marqués d'un astérisque (*) sont obligatoires.</source>
        <target>Fields marked with an asterisk (*) are required.</target>
      </trans-unit>
      <trans-unit id="create-school-toast" datatype="html">
        <source>Toast notifications</source>
        <target>Toast notifications</target>
      </trans-unit>

      <!-- Schools List Page -->
      <trans-unit id="schools-list-title" datatype="html">
        <source>Liste des écoles</source>
        <target>School List</target>
      </trans-unit>
      <trans-unit id="schools-list-description" datatype="html">
        <source>Consultez et gérez toutes les écoles enregistrées sur la plateforme.</source>
        <target>View and manage all schools registered on the platform.</target>
      </trans-unit>
      <trans-unit id="schools-list-create-button" datatype="html">
        <source>Nouvelle école</source>
        <target>New School</target>
      </trans-unit>
      <trans-unit id="schools-list-loading" datatype="html">
        <source>Chargement des écoles…</source>
        <target>Loading schools...</target>
      </trans-unit>
      <trans-unit id="schools-list-retry" datatype="html">
        <source>Réessayer</source>
        <target>Retry</target>
      </trans-unit>
      <trans-unit id="schools-list-empty-title" datatype="html">
        <source>Aucune école enregistrée</source>
        <target>No schools registered</target>
      </trans-unit>
      <trans-unit id="schools-list-empty-description" datatype="html">
        <source>Commencez par ajouter votre première école à la plateforme.</source>
        <target>Start by adding your first school to the platform.</target>
      </trans-unit>
      <trans-unit id="schools-list-empty-create" datatype="html">
        <source>Créer une école</source>
        <target>Create a school</target>
      </trans-unit>

      <!-- Replace Admin Page -->
      <trans-unit id="replace-admin-title" datatype="html">
        <source>Remplacer l'administrateur principal</source>
        <target>Replace the main administrator</target>
      </trans-unit>
      <trans-unit id="replace-admin-description" datatype="html">
        <source>Sélectionne un nouvel administrateur pour prendre en charge la gestion de l'école.</source>
        <target>Select a new administrator to take over school management.</target>
      </trans-unit>
      <trans-unit id="replace-admin-loading" datatype="html">
        <source>Chargement des informations de l'école...</source>
        <target>Loading school information...</target>
      </trans-unit>
      <trans-unit id="replace-admin-current" datatype="html">
        <source>Administrateur actuel : </source>
        <target>Current administrator: </target>
      </trans-unit>
      <trans-unit id="replace-admin-none" datatype="html">
        <source>Aucun administrateur principal assigné.</source>
        <target>No main administrator assigned.</target>
      </trans-unit>
      <trans-unit id="replace-admin-warning" datatype="html">
        <source>L'ancien administrateur conservera son historique mais perdra ses droits d'administration.</source>
        <target>The former administrator will keep their history but lose their administration rights.</target>
      </trans-unit>
      <trans-unit id="replace-admin-not-found" datatype="html">
        <source>École introuvable.</source>
        <target>School not found.</target>
      </trans-unit>

      <!-- Create School Form -->
      <trans-unit id="form-school-info" datatype="html">
        <source>Informations de l'école</source>
        <target>School Information</target>
      </trans-unit>
      <trans-unit id="form-school-name" datatype="html">
        <source>Nom de l'école *</source>
        <target>School Name *</target>
      </trans-unit>
      <trans-unit id="form-school-name-placeholder" datatype="html">
        <source>École primaire Jean Moulin</source>
        <target>Jean Moulin Primary School</target>
      </trans-unit>
      <trans-unit id="form-school-name-required" datatype="html">
        <source>Le nom de l'école est obligatoire.</source>
        <target>The school name is required.</target>
      </trans-unit>
      <trans-unit id="form-school-name-minlength" datatype="html">
        <source>Le nom doit contenir au moins 3 caractères.</source>
        <target>The name must contain at least 3 characters.</target>
      </trans-unit>
      <trans-unit id="form-school-code" datatype="html">
        <source>Code de l'école *</source>
        <target>School Code *</target>
      </trans-unit>
      <trans-unit id="form-school-code-placeholder" datatype="html">
        <source>ECO-2024-001</source>
        <target>ECO-2024-001</target>
      </trans-unit>
      <trans-unit id="form-school-code-required" datatype="html">
        <source>Le code de l'école est obligatoire.</source>
        <target>The school code is required.</target>
      </trans-unit>
      <trans-unit id="form-school-code-pattern" datatype="html">
        <source>Le code doit contenir uniquement des lettres majuscules, chiffres, tirets et underscores.</source>
        <target>The code must contain only uppercase letters, numbers, hyphens and underscores.</target>
      </trans-unit>
      <trans-unit id="form-school-email" datatype="html">
        <source>Email de l'école *</source>
        <target>School Email *</target>
      </trans-unit>
      <trans-unit id="form-school-email-placeholder" datatype="html">
        <source>contact@ecole.fr</source>
        <target>contact@school.com</target>
      </trans-unit>
      <trans-unit id="form-school-email-required" datatype="html">
        <source>L'email est obligatoire.</source>
        <target>Email is required.</target>
      </trans-unit>
      <trans-unit id="form-school-email-invalid" datatype="html">
        <source>Renseigne une adresse email valide.</source>
        <target>Enter a valid email address.</target>
      </trans-unit>
      <trans-unit id="form-school-phone" datatype="html">
        <source>Téléphone *</source>
        <target>Phone *</target>
      </trans-unit>
      <trans-unit id="form-school-phone-placeholder" datatype="html">
        <source>+33 1 23 45 67 89</source>
        <target>+1 234 567 8901</target>
      </trans-unit>
      <trans-unit id="form-school-phone-required" datatype="html">
        <source>Le téléphone est obligatoire.</source>
        <target>Phone number is required.</target>
      </trans-unit>
      <trans-unit id="form-school-phone-invalid" datatype="html">
        <source>Renseigne un numéro de téléphone valide.</source>
        <target>Enter a valid phone number.</target>
      </trans-unit>
      <trans-unit id="form-address" datatype="html">
        <source>Adresse</source>
        <target>Address</target>
      </trans-unit>
      <trans-unit id="form-address-label" datatype="html">
        <source>Adresse *</source>
        <target>Address *</target>
      </trans-unit>
      <trans-unit id="form-address-placeholder" datatype="html">
        <source>12 rue de la République</source>
        <target>12 Republic Street</target>
      </trans-unit>
      <trans-unit id="form-address-required" datatype="html">
        <source>L'adresse est obligatoire.</source>
        <target>Address is required.</target>
      </trans-unit>
      <trans-unit id="form-city" datatype="html">
        <source>Ville *</source>
        <target>City *</target>
      </trans-unit>
      <trans-unit id="form-city-placeholder" datatype="html">
        <source>Paris</source>
        <target>Paris</target>
      </trans-unit>
      <trans-unit id="form-city-required" datatype="html">
        <source>La ville est obligatoire.</source>
        <target>City is required.</target>
      </trans-unit>
      <trans-unit id="form-postal-code" datatype="html">
        <source>Code postal *</source>
        <target>Postal Code *</target>
      </trans-unit>
      <trans-unit id="form-postal-code-placeholder" datatype="html">
        <source>75001</source>
        <target>75001</target>
      </trans-unit>
      <trans-unit id="form-postal-code-required" datatype="html">
        <source>Le code postal est obligatoire.</source>
        <target>Postal code is required.</target>
      </trans-unit>
      <trans-unit id="form-postal-code-pattern" datatype="html">
        <source>Le code postal doit contenir 5 chiffres.</source>
        <target>Postal code must contain 5 digits.</target>
      </trans-unit>
      <trans-unit id="form-country" datatype="html">
        <source>Pays *</source>
        <target>Country *</target>
      </trans-unit>
      <trans-unit id="form-country-placeholder" datatype="html">
        <source>France</source>
        <target>France</target>
      </trans-unit>
      <trans-unit id="form-country-required" datatype="html">
        <source>Le pays est obligatoire.</source>
        <target>Country is required.</target>
      </trans-unit>
      <trans-unit id="form-administration" datatype="html">
        <source>Administration</source>
        <target>Administration</target>
      </trans-unit>
      <trans-unit id="form-admin-id" datatype="html">
        <source>ID Administrateur principal (optionnel)</source>
        <target>Main Administrator ID (optional)</target>
      </trans-unit>
      <trans-unit id="form-admin-id-placeholder" datatype="html">
        <source>admin-123</source>
        <target>admin-123</target>
      </trans-unit>
      <trans-unit id="form-admin-hint" datatype="html">
        <source>Laisse vide si aucun administrateur n'est encore assigné</source>
        <target>Leave empty if no administrator has been assigned yet</target>
      </trans-unit>
      <trans-unit id="form-reset" datatype="html">
        <source>Réinitialiser</source>
        <target>Reset</target>
      </trans-unit>
      <trans-unit id="form-submit-loading" datatype="html">
        <source>Enregistrement…</source>
        <target>Registering...</target>
      </trans-unit>
      <trans-unit id="form-submit" datatype="html">
        <source>Enregistrer l'école</source>
        <target>Register School</target>
      </trans-unit>

      <!-- Replace Admin Form -->
      <trans-unit id="replace-form-title" datatype="html">
        <source>Nouvel administrateur</source>
        <target>New Administrator</target>
      </trans-unit>
      <trans-unit id="replace-form-label" datatype="html">
        <source>ID du nouvel administrateur *</source>
        <target>New Administrator ID *</target>
      </trans-unit>
      <trans-unit id="replace-form-placeholder" datatype="html">
        <source>Identifiant de l'utilisateur</source>
        <target>User identifier</target>
      </trans-unit>
      <trans-unit id="replace-form-required" datatype="html">
        <source>L'identifiant de l'utilisateur est obligatoire.</source>
        <target>User identifier is required.</target>
      </trans-unit>
      <trans-unit id="replace-form-hint" datatype="html">
        <source>Renseigne l'identifiant unique de l'utilisateur qui deviendra l'administrateur principal.</source>
        <target>Enter the unique identifier of the user who will become the main administrator.</target>
      </trans-unit>
      <trans-unit id="replace-form-warning" datatype="html">
        <source>Cette action est irréversible. L'ancien administrateur perdra ses droits d'administration mais conservera son historique d'activité.</source>
        <target>This action is irreversible. The former administrator will lose their administration rights but keep their activity history.</target>
      </trans-unit>
      <trans-unit id="replace-form-submit-loading" datatype="html">
        <source>Remplacement en cours…</source>
        <target>Replacing...</target>
      </trans-unit>
      <trans-unit id="replace-form-submit" datatype="html">
        <source>Remplacer l'administrateur</source>
        <target>Replace Administrator</target>
      </trans-unit>

      <!-- Login Form -->
      <trans-unit id="login-email-label" datatype="html">
        <source>Adresse email</source>
        <target>Email address</target>
      </trans-unit>
      <trans-unit id="login-email-required" datatype="html">
        <source>Renseigne ton adresse email.</source>
        <target>Enter your email address.</target>
      </trans-unit>
      <trans-unit id="login-email-invalid" datatype="html">
        <source>Renseigne une adresse email valide.</source>
        <target>Enter a valid email address.</target>
      </trans-unit>
      <trans-unit id="login-password-label" datatype="html">
        <source>Mot de passe</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="login-password-show" datatype="html">
        <source>Afficher le mot de passe</source>
        <target>Show password</target>
      </trans-unit>
      <trans-unit id="login-password-hide" datatype="html">
        <source>Masquer le mot de passe</source>
        <target>Hide password</target>
      </trans-unit>
      <trans-unit id="login-password-required" datatype="html">
        <source>Renseigne ton mot de passe.</source>
        <target>Enter your password.</target>
      </trans-unit>
      <trans-unit id="login-password-minlength" datatype="html">
        <source>Le mot de passe doit contenir au moins 6 caractères.</source>
        <target>Password must contain at least 6 characters.</target>
      </trans-unit>
      <trans-unit id="login-submit-loading" datatype="html">
        <source>Connexion…</source>
        <target>Logging in...</target>
      </trans-unit>
      <trans-unit id="login-submit" datatype="html">
        <source>Se connecter</source>
        <target>Log in</target>
      </trans-unit>

      <!-- Admin Layout -->
      <trans-unit id="admin-layout-aria" datatype="html">
        <source>Navigation administrateur</source>
        <target>Administrator navigation</target>
      </trans-unit>
      <trans-unit id="admin-layout-home" datatype="html">
        <source>About Us — Accueil</source>
        <target>About Us — Home</target>
      </trans-unit>
      <trans-unit id="admin-layout-sidebar-aria" datatype="html">
        <source>Réduire ou ouvrir la barre latérale</source>
        <target>Collapse or expand sidebar</target>
      </trans-unit>
      <trans-unit id="admin-layout-header" datatype="html">
        <source>Espace administrateur</source>
        <target>Administrator space</target>
      </trans-unit>
      <trans-unit id="admin-layout-sidebar-aria-label" datatype="html">
        <source>Ouvrir ou fermer le menu administrateur</source>
        <target>Open or close administrator menu</target>
      </trans-unit>
    </body>
  </file>
</xliff>
